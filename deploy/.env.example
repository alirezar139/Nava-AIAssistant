HOST=0.0.0.0
PORT=4300
JWT_SECRET=replace-with-a-long-random-secret
# MySQL connection used by Prisma. Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql://root:password@127.0.0.1:3306/nava_ai_assistant
# Not load-bearing when IIS serves the frontend and reverse-proxies /api on the
# same origin (the browser sees same-origin requests). Kept as a safety net for
# hitting the Node port directly during debugging.
CORS_ORIGINS=http://localhost:4310,http://127.0.0.1:4310
SAHAND_TICKET_URL=https://sahand.dbaco.ir/rest/servicedeskapi/request
SAHAND_AUTHORIZATION=Basic replace-with-base64-credentials
SAHAND_AUTH_HEADER=
SAHAND_USERNAME=
SAHAND_PASSWORD=
SAHAND_SERVICE_DESK_ID=107
SAHAND_REQUEST_TYPE_ID=1185
SAHAND_RAISE_ON_BEHALF_OF=z.malmir
